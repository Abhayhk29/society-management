PORT=3001
NODE_ENV=development
CORE_GRPC_URL=localhost:50051
REALTIME_GRPC_URL=localhost:50052
ANALYTICS_GRPC_URL=localhost:50053
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# FRONTEND_ORIGIN=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
# memory (default locally) | redis (multi-instance)
THROTTLE_STORAGE=memory
# REDIS_URL=redis://localhost:6379
# THROTTLE_REDIS_PREFIX=nivas:throttle:gateway-bff:
# TRUST_PROXY=1
SWAGGER_ENABLED=true
LOG_FORMAT=json
SERVICE_NAME=gateway-bff
