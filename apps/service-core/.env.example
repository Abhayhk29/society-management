PORT=3008
GRPC_URL=0.0.0.0:50051
NODE_ENV=development

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=society_core
# true only for local throwaway DBs; use migrations otherwise
DB_SYNC=false
# run pending TypeORM migrations on boot
DB_MIGRATIONS_RUN=true

RBAC_SEED=true
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=900
REFRESH_EXPIRES_IN_SECONDS=604800
PASSWORD_RESET_EXPIRES_IN_SECONDS=3600
OTP_EXPIRES_IN_SECONDS=600
OTP_MAX_ATTEMPTS=5
FRONTEND_RESET_URL=http://localhost:3000/reset-password

SEED_ADMIN_EMAIL=admin@nivas.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin

INTERNAL_SERVICE_KEY=dev-internal-service-key

# Optional core HTTP CORS (gateway is the public edge)
# CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
# memory (default locally) | redis (multi-instance)
THROTTLE_STORAGE=memory
# REDIS_URL=redis://localhost:6379
# THROTTLE_REDIS_PREFIX=nivas:throttle:service-core:
# TRUST_PROXY=1
LOG_FORMAT=json
SERVICE_NAME=service-core
