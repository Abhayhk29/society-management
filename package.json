{
  "name": "society-management-workspace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend-nextjs",
    "dev:gateway": "npm run start:dev --workspace=gateway-bff",
    "dev:core": "npm run start:dev --workspace=service-core",
    "dev:realtime": "npm run dev --workspace=service-realtime",
    "dev:analytics": "npm run dev --workspace=service-analytics",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
  }
}
